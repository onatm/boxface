#!/bin/sh
set -eu

src=/usr/share/boxface/dotfiles
state="$HOME/.local/state/boxface"
chezmoi=/opt/boxface/profile/bin/chezmoi

started=$(date +%s%N)
mkdir -p "$HOME/.config/chezmoi" "$state"
printf 'sourceDir = "%s"\n' "$src" > "$HOME/.config/chezmoi/chezmoi.toml"
"$chezmoi" apply --no-tty
elapsed_ms=$(( ($(date +%s%N) - started) / 1000000 ))

{
  echo "revision: $(cat /usr/share/boxface/dotfiles-revision)"
  echo "applied: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "apply ms: $elapsed_ms"
  echo "chezmoi: $("$chezmoi" --version)"
  echo "managed:"
  "$chezmoi" managed | sed 's/^/  /'
} > "$state/personalisation.tmp"
mv "$state/personalisation.tmp" "$state/personalisation"
