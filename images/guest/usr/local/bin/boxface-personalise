#!/bin/sh
set -eu

src=/usr/share/boxface/home
manifest=/usr/share/boxface/home.manifest
state="$HOME/.local/state/boxface"
tab="$(printf '\t')"
mkdir -p "$state"
report="$state/personalisation.tmp"
{
  echo "revision: $(cat /usr/share/boxface/dotfiles-revision 2>/dev/null || echo none)"
  echo "applied: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "seeded:"
} > "$report"

if [ -f "$manifest" ]; then
  while IFS="$tab" read -r kind mode digest rel; do
    target="$HOME/$rel"
    if [ "$kind" = dir ]; then
      [ -e "$target" ] || install -d -m "$mode" "$target"
      continue
    fi
    if [ -L "$target" ]; then
      case "$(readlink "$target")" in
        /nix/*) rm "$target" ;;
      esac
    fi
    if [ -e "$target" ] || [ -L "$target" ]; then
      echo "  skipped $rel: a file you own is already there"
      continue
    fi
    if [ "$kind" = symlink ]; then
      ln -s "$digest" "$target"
    else
      cp "$src/$rel" "$target"
      chmod "$mode" "$target"
    fi
    echo "  $rel"
  done < "$manifest" >> "$report"
  cp "$manifest" "$state/personalisation.manifest"
fi
mv "$report" "$state/personalisation"
