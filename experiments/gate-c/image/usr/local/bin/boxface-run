#!/usr/bin/env bash
set -euo pipefail

BROKER_PORT=1025

usage() { echo "usage: boxface-run <binding>... -- <command> [args...]" >&2; exit 2; }

bindings=()
while [ $# -gt 0 ] && [ "$1" != -- ]; do bindings+=("$1"); shift; done
[ "${#bindings[@]}" -gt 0 ] && [ "${1:-}" = -- ] && [ $# -ge 2 ] || usage
shift

for binding in "${bindings[@]}"; do
  if ! reply="$(printf '%s\n' "$binding" | socat -t 30 - "VSOCK-CONNECT:2:$BROKER_PORT" 2>/dev/null)"; then
    echo "boxface-run: binding '$binding': credential broker unreachable" >&2
    exit 1
  fi
  case "$reply" in
    "ok "*)
      rest="${reply#ok }"
      export "${rest%% *}=${rest#* }"
      ;;
    "error "*)
      echo "boxface-run: binding '$binding': ${reply#error }" >&2
      exit 1
      ;;
    *)
      echo "boxface-run: binding '$binding': no reply from credential broker" >&2
      exit 1
      ;;
  esac
done

exec "$@"
